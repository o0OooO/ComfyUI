{
  "r1": { "class_type": "LoadImage", "inputs": { "image": "ref_a.png" }, "_meta": { "title": "参考 1:主角 A(正脸特写 + 转身,黑底最好)" } },
  "r2": { "class_type": "LoadImage", "inputs": { "image": "ref_b.png" }, "_meta": { "title": "参考 2:主角 B(或 A 的第二视角)" } },
  "r3": { "class_type": "LoadImage", "inputs": { "image": "sancai_tang_horse.jpg" }, "_meta": { "title": "参考 3:关键道具(产品图风格,多角度)" } },
  "r4": { "class_type": "LoadImage", "inputs": { "image": "wild_goose_pagoda.jpg" }, "_meta": { "title": "参考 4:场景/地点" } },

  "c1": { "class_type": "ResizeAndPadImage", "inputs": { "image": ["r1", 0], "target_width": 256, "target_height": 448, "padding_color": "black", "interpolation": "lanczos" } },
  "c2": { "class_type": "ResizeAndPadImage", "inputs": { "image": ["r2", 0], "target_width": 256, "target_height": 448, "padding_color": "black", "interpolation": "lanczos" } },
  "c3": { "class_type": "ResizeAndPadImage", "inputs": { "image": ["r3", 0], "target_width": 256, "target_height": 448, "padding_color": "black", "interpolation": "lanczos" } },
  "c4": { "class_type": "ResizeAndPadImage", "inputs": { "image": ["r4", 0], "target_width": 256, "target_height": 448, "padding_color": "black", "interpolation": "lanczos" } },

  "top": { "class_type": "ImageStitch", "inputs": { "image1": ["c1", 0], "image2": ["c2", 0], "direction": "right", "match_image_size": true, "spacing_width": 0, "spacing_color": "black" }, "_meta": { "title": "上排:主角 A | 主角 B" } },
  "bot": { "class_type": "ImageStitch", "inputs": { "image1": ["c3", 0], "image2": ["c4", 0], "direction": "right", "match_image_size": true, "spacing_width": 0, "spacing_color": "black" }, "_meta": { "title": "下排:道具 | 场景" } },
  "sheet": {
    "class_type": "ImageStitch",
    "inputs": { "image1": ["top", 0], "image2": ["bot", 0], "direction": "down", "match_image_size": true, "spacing_width": 0, "spacing_color": "black" },
    "_meta": { "title": "2x2 拼成 512x896 的 reference sheet(竖版) —— LTX 的多参考就是这一张图,不是喂 4 张独立图" }
  },
  "preview": { "class_type": "PreviewImage", "inputs": { "images": ["sheet", 0] }, "_meta": { "title": "先跑一次看拼图对不对、主体有没有被裁掉,再去改提示词" } },
  "rep": {
    "class_type": "RepeatImageBatch",
    "inputs": { "image": ["sheet", 0], "amount": 121 },
    "_meta": { "title": "图册 loop 成 121 帧静态视频当 in-context 条件;帧数必须和 EmptyLTXVLatentVideo 的 length 一致" }
  },

  "unet": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors", "weight_dtype": "default" }
  },
  "iclora": {
    "class_type": "LoraLoaderModelOnly",
    "inputs": { "model": ["unet", 0], "lora_name": "ltx-2.5-22b-ic-lora-ingredients-0.9.safetensors", "strength_model": 1.0 },
    "_meta": { "title": "Ingredients IC-LoRA(1.0~1.4;角色漂移就往上加)。这里叠在蒸馏基座上,所以不用再挂 distilled LoRA" }
  },
  "icp": {
    "class_type": "GetICLoRAParameters",
    "inputs": { "iclora_model": ["iclora", 0] },
    "_meta": { "title": "2.5 新增:从 LoRA 的 safetensors metadata 读 reference_downscale_factor 喂给 LTXVAddGuide。2.3 时代没这个节点,漏了会按 factor=1 处理、参考图 token 数不对" }
  },
  "clip": { "class_type": "CLIPLoader", "inputs": { "clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors", "type": "ltxv", "device": "default" } },
  "vvae": { "class_type": "VAELoader", "inputs": { "vae_name": "ltx-2.5-video-vae-bf16.safetensors" } },
  "avae": { "class_type": "VAELoader", "inputs": { "vae_name": "ltx-2.5-audio-vae-bf16.safetensors" } },

  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": ["clip", 0],
      "text": "### Reference Sheet Description\n**Top Row Left (Character):** <describe protagonist A - face close-up plus body turnaround: hair, eyes, skin tone, full outfit with colours and materials.>\n**Top Row Right (Character):** <describe protagonist B the same way, or a second view of A.>\n**Bottom Row Left (Prop):** <describe the key prop as a product-style render, multiple angles.>\n**Bottom Row Right (Setting):** <describe the location: architecture, lighting, background depth.>\n\n### Target Description\n<Describe the shot you want. Name every element exactly as worded above so the model binds them to the sheet. Cover, in order: shot size and camera move, who is present and what they wear, the action beat by beat, spoken dialogue in quotes, then lighting and ambient audio.>"
    },
    "_meta": { "title": "必须两段式(和训练时一致):Reference Sheet 段说「长什么样」,Target 段说「发生什么」。Target 里要用图册里同样的措辞重复一遍角色/道具,否则绑不上" }
  },
  "neg": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["clip", 0], "text": "pc game, console game, video game, cartoon, childish, ugly" } },
  "cond": { "class_type": "LTXVConditioning", "inputs": { "positive": ["pos", 0], "negative": ["neg", 0], "frame_rate": 24 } },

  "empty": {
    "class_type": "EmptyLTXVLatentVideo",
    "inputs": { "width": 512, "height": 896, "length": 121, "batch_size": 1 },
    "_meta": { "title": "单阶段直接出 512x896(竖版)。两条硬约束:(1) latent 是 16x28,必须能被 IC-LoRA 的 reference_downscale_factor 整除,否则 LTXVAddGuide 直接抛异常(16:9 的 736x416 就踩雷:latent 23x13 是奇数);(2) 图册的宽高比必须和这里一致,LTXVAddGuide 内部是 crop=center 缩放,比例不对会把格子裁掉。改横版:这里 896x512 + 4 个格子改 448x256" }
  },
  "guide": {
    "class_type": "LTXVAddGuide",
    "inputs": {
      "positive": ["cond", 0],
      "negative": ["cond", 1],
      "vae": ["vvae", 0],
      "latent": ["empty", 0],
      "image": ["rep", 0],
      "frame_idx": 0,
      "strength": 1.0,
      "iclora_parameters": ["icp", 0]
    },
    "_meta": { "title": "参考图册作为 in-context 引导。跟得太死、画面不动就把 strength 降到 0.8~0.9" }
  },
  "aud": { "class_type": "LTXVEmptyLatentAudio", "inputs": { "frames_number": 121, "frame_rate": 24, "batch_size": 1, "audio_vae": ["avae", 0] } },
  "cat": { "class_type": "LTXVConcatAVLatent", "inputs": { "video_latent": ["guide", 2], "audio_latent": ["aud", 0] } },

  "guider": {
    "class_type": "LTXVDualCFGGuider",
    "inputs": { "model": ["iclora", 0], "positive": ["guide", 0], "negative": ["guide", 1], "video_cfg": 1, "audio_cfg": 1 },
    "_meta": { "title": "conditioning 要取 LTXVAddGuide 的输出(带了参考 token),不能直接接 LTXVConditioning" }
  },
  "noise": { "class_type": "RandomNoise", "inputs": { "noise_seed": 20260930 } },
  "sel": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler_ancestral" } },
  "sig": {
    "class_type": "ManualSigmas",
    "inputs": { "sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0" },
    "_meta": { "title": "8 步蒸馏档。想要更高质量:换 dev 基座 + distilled-lora-450 旁路 + cfg 改 3/7 + 30 步线性 sigmas" }
  },
  "samp": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": { "noise": ["noise", 0], "guider": ["guider", 0], "sampler": ["sel", 0], "sigmas": ["sig", 0], "latent_image": ["cat", 0] }
  },
  "sep": { "class_type": "LTXVSeparateAVLatent", "inputs": { "av_latent": ["samp", 0] } },
  "crop": {
    "class_type": "LTXVCropGuides",
    "inputs": { "positive": ["guide", 0], "negative": ["guide", 1], "latent": ["sep", 0] },
    "_meta": { "title": "把参考图册那些 token 从 latent 里剥掉,不然解码出来前面会多一段图册画面" }
  },
  "dec": { "class_type": "VAEDecodeTiled", "inputs": { "samples": ["crop", 2], "vae": ["vvae", 0], "tile_size": 512, "overlap": 64, "temporal_size": 64, "temporal_overlap": 16 } },
  "adec": { "class_type": "LTXVAudioVAEDecode", "inputs": { "samples": ["sep", 1], "audio_vae": ["avae", 0] } },
  "mkvid": { "class_type": "CreateVideo", "inputs": { "images": ["dec", 0], "audio": ["adec", 0], "fps": 24 } },
  "save": { "class_type": "SaveVideo", "inputs": { "video": ["mkvid", 0], "filename_prefix": "video/ltx2.5_multiref", "format": "auto", "format.codec": "auto" } }
}
